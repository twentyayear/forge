{
  "name": "workhart-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "migrate:create": "node-pg-migrate create -j sql",
    "migrate:up": "node --env-file=/etc/workhart/env node_modules/.bin/node-pg-migrate up",
    "migrate:up:test": "node --env-file=/etc/workhart/env node_modules/.bin/node-pg-migrate up -d TEST_DATABASE_URL",
    "seed": "node --env-file=/etc/workhart/env seed.js",
    "test": "NODE_ENV=test node --env-file=/etc/workhart/env --test test/schema.test.js test/auth.test.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1"
  }
}
